# ═══════════════════════════════════════════════════════════
# TELEGRAM MARKETPLACE BOT — .env.example
# Скопируйте в .env и заполните своими значениями
# ═══════════════════════════════════════════════════════════

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Ваш Telegram ID (для админки). Узнать: @userinfobot
ADMIN_TELEGRAM_ID=123456789

# --- AI Providers ---
# Groq — основной AI (диспетчеризация + модерация чата)
# Получить: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
# Default Groq model for the unified AI service (client dispatcher, moderation,
# partner understanding, admin research). Optional — falls back to a sensible
# default when unset. Per-contour override: PARTNER_ONBOARDING_MODEL.
GROQ_MODEL=llama-3.1-8b-instant
# PARTNER_ONBOARDING_MODEL=llama-3.1-8b-instant

# OpenAI — ТОЛЬКО для Whisper STT (распознавание голоса)
# Получить: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxx

# --- Database (Supabase) ---
# Вариант 1: Supabase (рекомендуется)
#   Формат: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#   Важно: используйте POOLER URL (порт 6543), а не прямой (порт 5432)
#   Найти: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Вариант 2: Локальный PostgreSQL
# DATABASE_URL=postgresql://bot:botpass@localhost:5432/marketplace

# --- Idram Payment Gateway ---
# Получить: https://idram.am → Для бизнеса → Мерчант
# Пока можно оставить test — оплата будет заглушкой
IDRAM_MERCHANT_ID=test
IDRAM_SECRET_KEY=test
IDRAM_SUCCESS_URL=https://your-domain.com/api/idram/success
IDRAM_FAIL_URL=https://your-domain.com/api/idram/fail
# ВАЖНО (боевой режим): в личном кабинете Idram укажите Result URL =
#   https://your-domain.com/api/idram/result
# На него Idram шлёт pre-check и подтверждение платежа (проверка EDP_CHECKSUM).

# --- Web App URLs ---
# Локально с ngrok:   https://xxxx.ngrok-free.app
# На сервере:         https://your-domain.com
# Supabase Edge: НЕ подходит — нужен свой сервер для aiohttp
WEBAPP_BASE_URL=https://your-domain.com

# --- AI Research / Potential Partners ---
# Optional. Without this key the admin research adapter stays disabled and no fake data is generated.
SEARCH_PROVIDER=serper
SERPER_API_KEY=
